# =============================================================================
# Black CRM — variables de entorno
#
# Ninguna es obligatoria: sin valores, el sitio funciona como demo con datos
# ficticios y no se conecta a ningún servicio.
# Copia este archivo a .env.local y completa solo lo que vayas a usar.
# Nunca subas .env.local al repositorio. Detalle: docs/INTEGRACIONES.md
# =============================================================================

# --- Sitio (públicas) --------------------------------------------------------
# URL canónica del despliegue (metadata, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# demo: datos ficticios en el navegador. live: reservado para que la interfaz lea de la API
# propia cuando exista una base de datos (en esta demo no cambia el comportamiento).
NEXT_PUBLIC_BLACK_CRM_MODE=demo
# Enlace de «Quiero un CRM así» en los créditos (opcional). Vacío = WhatsApp de Black Crow con mensaje escrito.
NEXT_PUBLIC_CONTACT_URL=
# Sitio de Black Crow (opcional). Vacío = https://www.blackcrow.agency
NEXT_PUBLIC_BLACKCROW_URL=

# --- Datos (privadas) --------------------------------------------------------
# demo | postgres. Con «postgres» los movimientos se guardan en la base de datos.
BLACK_CRM_DATA_SOURCE=demo
# Cadena de conexión PostgreSQL (Neon, Supabase, RDS…), p. ej. postgres://usuario:clave@host:5432/black_crm
DATABASE_URL=
# Zona horaria del negocio (cortes diarios, «ventas de hoy») y moneda.
BLACK_CRM_TIMEZONE=America/Lima
BLACK_CRM_CURRENCY=PEN
# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
BLACK_CRM_ALLOWED_ORIGINS=
# Secreto para firmar envíos a /api/webhooks/ingest (eventos ya normalizados, HMAC-SHA256).
BLACK_CRM_INGEST_SECRET=

# --- Tienda online: Shopify --------------------------------------------------
# Dominio de la tienda, p. ej. mitienda.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Token de la app personalizada (Admin API) con permisos de productos, inventario y pedidos.
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Secreto con el que Shopify firma los webhooks (orders/create, refunds/create).
SHOPIFY_WEBHOOK_SECRET=
# Ubicación de Shopify que corresponde a la tienda o almacén.
SHOPIFY_LOCATION_ID=

# --- Tienda online: WooCommerce ----------------------------------------------
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Secreto configurado en el webhook «Pedido creado».
WOOCOMMERCE_WEBHOOK_SECRET=

# --- Punto de venta (POS) ----------------------------------------------------
# Secreto compartido con el POS para firmar cada ticket enviado a /api/webhooks/pos.
POS_WEBHOOK_SECRET=

# --- ERP / contabilidad ------------------------------------------------------
# none | odoo
ERP_PROVIDER=none
ODOO_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

# --- Pedidos a proveedores ---------------------------------------------------
# none | email | webhook. En modo demo nunca se envía nada.
SUPPLIER_ORDERS_CHANNEL=none
# Correo transaccional (Resend) y remitente verificado.
RESEND_API_KEY=
PURCHASE_ORDERS_FROM_EMAIL=
# Webhook del portal de proveedores y secreto para firmar los envíos.
SUPPLIER_WEBHOOK_URL=
SUPPLIER_WEBHOOK_SECRET=

# --- Pronóstico --------------------------------------------------------------
# local: motor incluido · external: servicio propio con la misma interfaz.
FORECAST_PROVIDER=local
FORECAST_SERVICE_URL=
FORECAST_SERVICE_TOKEN=

# --- Avisos y tareas programadas ---------------------------------------------
# Webhook de Slack, Teams o pasarela de WhatsApp para enviar avisos al equipo.
ALERTS_WEBHOOK_URL=
# Secreto que deben enviar las tareas programadas (resumen diario de avisos).
CRON_SECRET=
